# Before publishing .npmignore is merged with .gitignore files,
# see package.json > scripts > prepack.

!.gitignore
internal
.claude
# Internal-only Claude Code content must NOT be published. 
# Keep these even if we decide to ship the public .claude setup later:
#   - internal skills use the "internal-" directory prefix 
#   - any "internal" folder elsewhere under .claude (e.g. .claude/rules/internal)
.claude/skills/internal-*
.claude/**/internal/
prepare-oss.sh
.ossignore
# It's necessary to include this empty line, as merge of .npmignore and .gitignore get's messed up otherwise

